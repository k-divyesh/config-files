! Swap Ctrl and Alt, and Caps Lock and Escape
clear control
clear mod1
clear Lock

! Physical key remaps
keycode 37 = Alt_L       ! Left Ctrl -> Alt
keycode 64 = Control_L   ! Left Alt -> Ctrl
keycode 105 = Alt_R
keycode 108 = Control_R
keycode 66 = Escape      ! Caps Lock -> Escape
keycode 9 = Caps_Lock    ! Escape -> Caps Lock
